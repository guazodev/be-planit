{
  "openapi": "3.0.4",
  "info": {
    "title": "PlanIT.WebApi",
    "version": "1.0"
  },
  "paths": {
    "/api/travels": {
      "post": {
        "tags": [
          "PlanIT.WebApi"
        ],
        "operationId": "CreateTravel",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TravelCreationDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/travels/user/{userId}": {
      "get": {
        "tags": [
          "PlanIT.WebApi"
        ],
        "operationId": "GetUserTravels",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "TravelCreationDto": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "destination": {
            "type": "string",
            "nullable": true
          },
          "durationDays": {
            "type": "integer",
            "format": "int32"
          },
          "estimatedBudget": {
            "type": "number",
            "format": "double"
          },
          "travelStyle": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
  }
}